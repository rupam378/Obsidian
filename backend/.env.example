# Obsidian Vault Configuration
VAULT_PATH=./vault
DB_PATH=./lancedb
PORT=5000

# LLM Configuration (for RAG)
# Set LLM_ENABLED=true to load a local GGUF model for AI-powered generation.
# Leave it false to keep the assistant working in template fallback mode.
LLM_ENABLED=false
LLM_MODEL_PATH=
LLM_N_CTX=2048
LLM_N_THREADS=4